version=QCC514X_CONFIG
##############################
file=system3
# The capacitance for driving a crystal providing the raw clock
XtalLoadCapacitance = 0x10
# Fine frequency trim for a crystal providing the raw chip clock
XtalFreqTrim = 0
##############################
file=bt2
# BD_ADDRESS
BD_ADDRESS = [ CHANGE_BT_ADDRESS ]
##############################
file=app3
# License Key for product feature
FeatureLicenseKey = [ C3 D1 A0 F5 F2 0C 32 0C 7C 65 B2 BD 9C B2 8B BB 20 F5 8B F2 2E 3F 62 2D C2 9E 83 5D AB 8E 4E 2E 52 79 7C EF F8 FD 64 AE 5B DC C9 94 59 2E 6D 6F C0 67 95 5F FA C6 C8 CC 4D F3 37 51 2D 5E 3A CC ]
##############################
file=app5
# MIB key to set device name
DeviceName = "CHANGE_BT_NAME"
##############################
file=app7
CustomerReadOnlyKey0 = [CHANGE_HEX_VERSION]